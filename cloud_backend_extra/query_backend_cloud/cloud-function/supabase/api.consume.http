### 5️⃣ Ejecutar generación de embeddings (procesamiento por lotes)
POST {{baseURL}}/system/run_embedding
{{headers}}
{{json}}

{}

> {%
client.test("El proceso de embeddings responde correctamente", function() {
  client.assert(response.status === 200, "Debe responder 200 OK");
  const data = response.body;
  client.assert(data.message.includes("Embeddings generados"), "Debe incluir mensaje de procesamiento");
});
%}


### 6️⃣ Probar query vacío (debería dar error)
POST {{baseURL}}/search
{{headers}}
{{json}}

{
  "query": ""
}

> {%
client.test("Debe devolver error si el query está vacío", function() {
  client.assert(response.status !== 200, "Debe fallar con query vacío");
});
%}
